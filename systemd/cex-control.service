
[Unit]
Description=CEX Control Plane (Bun)
After=network.target cex-engine.service
Requires=cex-engine.service
StartLimitBurst=3
StartLimitIntervalSec=60


[Service]
Type=simple
# Run as dedicated service user, not root
User=cex-engine
Group=cex-engine
WorkingDirectory=/opt/cex-zig/ts
EnvironmentFile=/opt/cex-zig/.env
ExecStart=/usr/local/bin/bun src/index.ts
# Sandboxing / hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
# Filesystem access
ReadOnlyPaths=/opt/cex-zig
ReadWritePaths=/opt/cex-zig/db /opt/cex-zig/zig/data
# Restart policy
Restart=on-failure
RestartSec=5
# Timeout policies
TimeoutStartSec=30
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
