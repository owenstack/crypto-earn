# --- Stage 1: Build the Zig engine ---
FROM debian:bookworm-slim AS builder

ARG ZIG_VERSION=0.15.2
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl xz-utils \
    libsqlite3-dev libsecp256k1-dev \
  && rm -rf /var/lib/apt/lists/*

# Install Zig
RUN case "${TARGETARCH}" in \
      amd64) ZIG_ARCH="x86_64" ;; \
      arm64) ZIG_ARCH="aarch64" ;; \
      *) echo "Unsupported arch: ${TARGETARCH}" && exit 1 ;; \
    esac && \
    curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-${ZIG_ARCH}-linux-${ZIG_VERSION}.tar.xz" \
      -o /tmp/zig.tar.xz && \
    tar xf /tmp/zig.tar.xz -C /usr/local && \
    mv /usr/local/zig-*-linux-* /usr/local/zig && \
    ln -s /usr/local/zig/zig /usr/local/bin/zig && \
    rm /tmp/zig.tar.xz

WORKDIR /build
COPY zig/ ./

# Pre-populate Zig global package cache from vendored deps (avoids network fetch)
RUN mkdir -p /root/.cache/zig/p && \
    cp -r .cache/zig/p/* /root/.cache/zig/p/ 2>/dev/null || true

RUN zig build -Doptimize=ReleaseFast

# --- Stage 2: Minimal runtime ---
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libsqlite3-0 libsecp256k1-1 \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd --system cex && useradd --system --gid cex --no-create-home cex

WORKDIR /app

COPY --from=builder /build/zig-out/bin/cex-engine /app/cex-engine

RUN mkdir -p /app/data && chown -R cex:cex /app

USER cex

ENV DB_PATH=/app/data/cex.db
ENV IPC_SOCKET=/ipc/cex-engine.sock

CMD ["/app/cex-engine"]
