# Required
IPC_SOCKET=/tmp/cex-engine.sock
DB_PATH=./data/cex.db
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_ALLOWED_CHAT_IDS=your_chat_id
DASHBOARD_SECRET=generate_with_openssl_rand_hex_32

# ─── Hyperliquid (Phase 2) ──────────────────────────────────────────────────
# Network selector: "testnet" or "mainnet". Testnet uses chainId 998 and
# https://api.hyperliquid-testnet.xyz; mainnet uses chainId 999 and
# https://api.hyperliquid.xyz. Required when DRY_RUN is unset.
HL_NETWORK=testnet

# 32-byte API Wallet private key (with or without 0x prefix). Required when
# DRY_RUN is unset. NEVER committed; the engine derives the signer address at
# startup and logs only the address — never the key.
HL_API_PRIVATE_KEY=

# EIP-712 domain values — defaults match the HL Exchange spec. Override only
# if HL changes the domain or for local replay tooling.
HL_EIP712_NAME=Exchange
HL_EIP712_VERSION=1
HL_EIP712_VERIFIER_MAINNET=0x2df1c51e09aecf9cacb7bc98cb1742757f163df3
HL_EIP712_VERIFIER_TESTNET=0x08cfc1B6b2dCF36A1480b99353A354AA8AC56f89

# Optional: explicit chainId override. Leave unset to use 998 (testnet) or
# 999 (mainnet) per HL_NETWORK.
# HL_CHAIN_ID=999
# Domain Name: "USD Coin" (Mainnet) / "USDC2" (Testnet)
# Domain Version: "2" (Mainnet) / "1" (Testnet)

# Strategy toggles (1 = enabled at startup)
ENABLE_LIQUIDITY_PROVISION=1

# Dry-run mode (remove this line to go live)
DRY_RUN=1

# Optional
DASHBOARD_PORT=3000
LOG_LEVEL=info
NODE_ENV=production
DRY_RUN_INITIAL_BALANCE=10.0
