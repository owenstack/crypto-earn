# ── Engine (Zig) ────────────────────────────────────────────────────────────
DB_PATH=./data/cex.db
IPC_SOCKET=/tmp/cex-engine.sock
LOG_LEVEL=info

# ── Telegram bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token-here
# Comma-separated list of allowed Telegram chat IDs
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
# Bearer token for dashboard HTTP API (/api/*). Generate with: openssl rand -hex 32
DASHBOARD_SECRET=change-me-in-production

# ── Shared ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Dry-run mode ─────────────────────────────────────────────────────────────
# DRY_RUN=1 enables dry-run mode (signals logged but no orders placed)
# DRY_RUN_INITIAL_BALANCE=10.0 sets simulated starting balance for P&L analysis
DRY_RUN=1
DRY_RUN_INITIAL_BALANCE=10.0

# ── Strategy auto-enable on startup (set to "1" or "true") ───────────────────
ENABLE_NEWS_REPRICING=1
ENABLE_LIQUIDITY_PROVISION=1
